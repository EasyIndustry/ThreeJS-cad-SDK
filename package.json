{
  "name": "threejs-cad-sdk",
  "version": "0.3.0",
  "description": "Modelo de CAD para apps de three.js: piezas, ensambles, marcos locales y del mundo, contacto e intersección. Núcleo puro (corre en Node y en el navegador) y un adaptador para three.",
  "type": "module",
  "license": "MIT",
  "author": "EasyIndustry",
  "repository": { "type": "git", "url": "git+https://github.com/EasyIndustry/ThreeJS-cad-SDK.git" },
  "exports": {
    ".": "./src/index.js",
    "./three": "./adapters/three/viewer.js"
  },
  "files": ["src", "adapters", "examples", "LICENSE", "README.md"],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": { "three": ">=0.160.0" },
  "peerDependenciesMeta": { "three": { "optional": true } },
  "devDependencies": { "typescript": "^6.0.0" },
  "engines": { "node": ">=20" }
}
